# ─── Team invite emails (optional) ─────────────────────────────────
# Generic SMTP — works with Gmail, SendGrid, Postmark, Resend's SMTP relay,
# or your own mail server. Leave blank to skip email sending entirely —
# adding someone to the team still grants access immediately either way;
# this only controls whether they also get notified by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Database ────────────────────────────────────────────────────
# Postgres connection string (Supabase/Neon/Render Postgres/etc).
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=true

# ─── App ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Your real deployed URL (e.g. https://your-app.onrender.com) — no
# trailing slash. Required for ACC webhook registration; leave as
# localhost until you've deployed, since ACC can't call your laptop.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Automatic re-sync of LINKED issues (every 2 min by default) ───
# This does NOT push new/unlinked issues automatically — only issues you've
# already chosen to link via the UI. Set to false to disable entirely.
POLL_ENABLED=true
POLL_CRON=*/2 * * * *

# ─── Autodesk Platform Services (APS / ACC) ───────────────────────
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Must exactly match the callback URL registered in your APS app.
# Use your real hosted URL in production, not localhost.
APS_CALLBACK_URL=http://localhost:3000/auth/acc/callback

# ─── Revizto ─────────────────────────────────────────────────────
# Nothing needed here — Revizto has no client credentials or webhook
# system. Auth is per-user via access code (see the app's Connections
# page), and Revizto-side updates are pulled via API calls (on-demand
# button or the optional poller below), not pushed to us.

# ─── ACC webhook verification ─────────────────────────────────────
# Secret used to verify that calls to /webhook/acc genuinely came from
# Autodesk (ACC has webhooks; Revizto does not — this has nothing to do
# with Revizto). Autodesk signs every delivery (X-Adsk-Signature = HMAC-SHA1
# of the raw body, keyed with this token). Setup: pick a random 32-64 character
# alphanumeric token, register the SAME token with Autodesk (POST
# https://developer.api.autodesk.com/webhooks/v1/tokens, body {"token": "..."},
# per Autodesk's "How to verify payload signature"), and put it here.
WEBHOOK_SECRET=
# What a bad/missing signature does: off | log (default: check + log, still
# process) | enforce (ignore the delivery, still answer 200). Roll out in
# order: set the secret, watch Render's log for "[webhook] Signature verified.",
# then switch to enforce.
WEBHOOK_SIGNATURE_MODE=log

# ─── Stored connection tokens (Revizto / ACC) ─────────────────────
# Encrypts the saved Revizto and ACC tokens in the database (AES-256-GCM,
# services/tokenCrypto.js). KEEP A COPY OF THE KEY SOMEWHERE SAFE: without it
# the saved tokens can't be read and everyone has to reconnect Revizto and ACC.
#   1. Make a key:            npm run tokens:encrypt -- --new-key
#   2. Set TOKEN_ENCRYPTION_KEY on the server (leave WRITE off), deploy.
#   3. Set TOKEN_ENCRYPTION_WRITE=on — newly saved tokens are encrypted.
#   4. Convert the existing rows:  npm run tokens:encrypt            (dry run)
#                                  npm run tokens:encrypt -- --apply
# To go back: set WRITE off, then  npm run tokens:encrypt -- --decrypt --apply
# Rotating: put the old key in TOKEN_ENCRYPTION_OLD_KEYS, set a new
# TOKEN_ENCRYPTION_KEY, then run the --apply conversion with --reencrypt.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_OLD_KEYS=
TOKEN_ENCRYPTION_WRITE=off
